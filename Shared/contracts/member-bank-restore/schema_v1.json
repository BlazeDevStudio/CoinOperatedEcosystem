{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemberBankRestoreContractV1",
  "description": "Atomic transaction commit record and replay format for member balances and audit events",
  "type": "object",
  "required": ["version", "commit_sha256", "files"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "commit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "staged_sha256"],
        "properties": {
          "path": {
            "type": "string"
          },
          "staged_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
