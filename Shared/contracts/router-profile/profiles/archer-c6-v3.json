{
  "profile_id": "archer-c6-v3",
  "name": "TP-Link Archer C6 v3 / A6 v3 Appliance",
  "version": "1.0.0",
  "target_architecture": "ramips/mt7621",
  "detection": {
    "board_name_pattern": ".*tplink,archer-c6-v3.*|.*tplink,archer-a6-v3.*",
    "model_pattern": ".*Archer C6 v3.*|.*Archer A6 v3.*"
  },
  "hardware": {
    "flash_kb": 16384,
    "ram_mb": 128,
    "min_free_overlay_kb": 2048,
    "cpu_cores": 2,
    "storage_type": "nor_spi"
  },
  "networking": {
    "wan_interface": "wan",
    "lan_interface": "br-lan",
    "switch_type": "dsa",
    "ports": [
      { "label": "WAN", "interface": "wan", "speed_mbps": 1000 },
      { "label": "LAN1", "interface": "lan1", "speed_mbps": 1000 },
      { "label": "LAN2", "interface": "lan2", "speed_mbps": 1000 },
      { "label": "LAN3", "interface": "lan3", "speed_mbps": 1000 },
      { "label": "LAN4", "interface": "lan4", "speed_mbps": 1000 }
    ],
    "vlan_supported": true,
    "default_vlan_ids": {
      "lan": 1,
      "guest": 10,
      "vendo": 20
    }
  }
}
