{
  "profile_id": "nanopi-r2s",
  "name": "FriendlyElec NanoPi R2S Appliance",
  "version": "1.0.0",
  "target_architecture": "rockchip/arm64",
  "detection": {
    "board_name_pattern": ".*friendlyarm,nanopi-r2s.*|.*nanopi-r2s.*",
    "model_pattern": ".*NanoPi R2S.*"
  },
  "hardware": {
    "flash_kb": 8388608,
    "ram_mb": 1024,
    "min_free_overlay_kb": 100000,
    "cpu_cores": 4,
    "storage_type": "emmc"
  },
  "networking": {
    "wan_interface": "eth0",
    "lan_interface": "br-lan",
    "switch_type": "generic",
    "ports": [
      { "label": "WAN", "interface": "eth0", "speed_mbps": 1000 },
      { "label": "LAN", "interface": "eth1", "speed_mbps": 1000 }
    ],
    "vlan_supported": true,
    "default_vlan_ids": {
      "lan": 1,
      "guest": 10,
      "vendo": 20
    }
  }
}
