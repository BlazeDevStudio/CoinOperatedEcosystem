{
  "profile_id": "orangepi-zero3",
  "name": "Orange Pi Zero 3 Appliance",
  "version": "1.0.0",
  "target_architecture": "sunxi/cortexa53",
  "detection": {
    "board_name_pattern": ".*xunlong,orangepi-zero3.*|.*orangepi-zero-3.*",
    "model_pattern": ".*Orange Pi Zero 3.*"
  },
  "hardware": {
    "flash_kb": 4194304,
    "ram_mb": 1024,
    "min_free_overlay_kb": 100000,
    "cpu_cores": 4,
    "storage_type": "emmc"
  },
  "networking": {
    "wan_interface": "eth0",
    "lan_interface": "br-lan",
    "switch_type": "generic",
    "ports": [
      { "label": "GbE", "interface": "eth0", "speed_mbps": 1000 },
      { "label": "WLAN", "interface": "wlan0", "speed_mbps": 433 }
    ],
    "vlan_supported": true,
    "default_vlan_ids": {
      "lan": 1,
      "guest": 10,
      "vendo": 20
    }
  }
}
