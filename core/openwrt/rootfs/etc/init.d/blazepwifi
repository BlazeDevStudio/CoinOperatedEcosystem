#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

# Read-only fail-closed boot check before registering the core daemon.
bp_config_boot_preflight() {
	[ -d /etc/blazepwifi ] && [ ! -L /etc/blazepwifi ] &&
		[ -r /etc/blazepwifi ] || return 1
	[ -r /usr/lib/blazepwifi/config.sh ] &&
		[ ! -L /usr/lib/blazepwifi/config.sh ] || return 1
	# Do not trust an inherited environment override of the pending path.
	BP_CONFIG_PENDING_FILE=/etc/blazepwifi/.config-transaction.pending
	export BP_CONFIG_PENDING_FILE
	. /usr/lib/blazepwifi/config.sh || return 1
	command -v bp_config_recovery_status >/dev/null 2>&1 || return 1
	bp_config_recovery_status || return 1
}

start_service() {
	config_load blazepwifi
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	if ! bp_config_boot_preflight; then
		printf "%s\n" "blazepwifi core startup denied: pending configuration or recovery guard unavailable" >&2
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/blazepwifi-core
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() { nft delete table inet blazepwifi 2>/dev/null || true; }
service_triggers() { procd_add_reload_trigger blazepwifi network firewall; }
